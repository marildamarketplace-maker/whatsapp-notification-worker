NODE_ENV=production
DATABASE_URL=
DIRECT_URL=
EVOLUTION_API_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=notificacoes
POLL_INTERVAL_MS=10000
BATCH_SIZE=10
MAX_CONCURRENT_SENDS=1
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=30000
SEND_DELAY_MS=1500
REQUEST_TIMEOUT_MS=15000
LOCK_TIMEOUT_SECONDS=120
LOG_LEVEL=info
# Verified TLS CA for PostgreSQL (optional for public trusted CAs)
# PG_CA_FILE=/run/secrets/supabase-ca.crt
# EVOLUTION_TEST_RECIPIENT=120363412284116447-group
# EVOLUTION_TEST_SEND=false
